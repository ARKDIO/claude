<?xml version="1.0" encoding="utf-8"?>
<!-- HTTPS만 허용하고, 시스템 기본 인증서만 신뢰해요 (사용자가 설치한 인증서 기반 가로채기 차단). -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
